# relevo uses no secrets, API keys or credentials. Never put any in this project.
#
# These optional variables tune the orchestrator. Define them in the "env" block of
# ~/.claude/settings.json, or export them in the environment that launches Claude Code.
# Everything below is commented out: the defaults are fine for most setups.

# Path of the telemetry log written by hooks/orch-telemetry and read by orchestrator/stats.py.
# It MUST be an absolute path: "~" is not expanded by the current code.
# Default when unset: ~/.claude/orchestrator/log.jsonl
# ORCH_LOG=/absolute/path/log.jsonl

# Maximum depth of subagent spawning. Invariant of the design: keep it at 1 so that
# workers cannot launch other subagents. The installer writes it to settings.json "env".
# CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=1

# Default model for subagents that do not declare "model:" in their frontmatter.
# CLAUDE_CODE_SUBAGENT_MODEL=sonnet
