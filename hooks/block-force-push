#!/usr/bin/env python3
# PreToolUse(Bash): bloquea force push en cualquier sintaxis (flag al final, -C dir, +refspec,
# bash -c "...", --mirror, --force-with-lease). permissions.deny solo cubre la forma canónica.
import json, re, shlex, sys

def segments(cmd):
    # Trocea por separadores de shell y abre sh/bash/zsh -c "..." recursivamente.
    for part in re.split(r"&&|\|\||[;|\n&()`]|\$\(", cmd):
        try:
            toks = shlex.split(part, posix=True)
        except ValueError:
            toks = part.split()
        for i, t in enumerate(toks):
            if t.rsplit("/", 1)[-1] in ("sh", "bash", "zsh") and "-c" in toks[i + 1:i + 2] and i + 2 < len(toks):
                yield from segments(toks[i + 2])
        yield toks

def is_force_push(toks):
    for i, t in enumerate(toks):
        if t.rsplit("/", 1)[-1] != "git":
            continue
        j = i + 1
        while j < len(toks) and toks[j].startswith("-"):  # opciones globales: -C dir, -c k=v, --no-pager...
            j += 2 if toks[j] in ("-C", "-c", "--git-dir", "--work-tree", "--namespace") else 1
        if j >= len(toks) or toks[j] != "push":
            continue
        for a in toks[j + 1:]:
            if a.startswith("--force") or a == "--mirror" or a == "--delete":
                return True
            if re.fullmatch(r"-[a-zA-Z]*[fd][a-zA-Z]*", a):
                return True
            if a.startswith("+") or re.match(r"^:[^:]", a):  # +refspec (force) o :rama (borrado remoto)
                return True
    return False

try:
    cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "") or ""
except Exception:
    sys.exit(0)
if any(is_force_push(t) for t in segments(cmd)):
    print("Force push / borrado remoto bloqueado por ~/.claude/hooks/block-force-push. "
          "Pide al usuario que lo ejecute él con '! git push ...'.", file=sys.stderr)
    sys.exit(2)
sys.exit(0)
