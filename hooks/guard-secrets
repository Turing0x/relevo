#!/usr/bin/env python3
# PreToolUse(Bash|Grep|Read): pide confirmación humana si la llamada referencia explícitamente
# .env, claves privadas o credenciales. permissions.ask solo cubre Read(**/.env*); esto cubre
# cat/grep/rg/source vía Bash (incl. sh -c, eval, python/node -c/-e), la herramienta Grep y Read.
# Defensa en profundidad, no sandbox. No detecta: grep recursivo sobre un directorio sin nombrar el
# secreto, carga implícita (dotenv, printenv tras source), ofuscación, herramienta Glob.
# Falsos positivos asumidos (ask, no deny): nombres de secreto usados como patrón de búsqueda.
import fnmatch, json, re, shlex, sys

SAFE = re.compile(r"\.env(\.[^/]*)?\.(example|sample|template|dist)$", re.I)
SECRET = re.compile(
    r"(^|/)(\.env(\..+)?|\.envrc|\.netrc|\.pgpass|credentials(\.json)?|id_(rsa|ed25519|ecdsa)|"
    r"[^/]*\.(pem|key|p12|pfx))$"
    r"|(^|/)(\.aws|\.ssh|\.gnupg|\.config/gcloud)(/|$)", re.I)
CANON = (".env", ".env.local", ".envrc", ".netrc", "credentials.json", "id_rsa", "x.pem", "x.key", ".aws/x", ".ssh/x")
SHELLS, INTERP = ("sh", "bash", "zsh"), ("python", "python3", "node", "ruby", "perl", "deno", "bun")

def excluded(t):
    return t.startswith(("!", "--exclude", "--ignore", "--glob=!", "--iglob=!"))

def is_secret(p):
    p = p.strip().strip("'\"").rstrip("*")
    return bool(p) and bool(SECRET.search(p)) and not SAFE.search(p)

def candidates(cmd):
    # Tokens de shell + trozos tras =, <, >, "," (F=.env, cat<.env, --env-file=.env) + código inline de intérpretes.
    for part in re.split(r"&&|\|\||[;|\n&()`]|\$\(", cmd):
        try:
            toks = shlex.split(part, posix=True)
        except ValueError:
            toks = part.split()
        for i, t in enumerate(toks):
            base = t.rsplit("/", 1)[-1]
            nxt = toks[i + 1] if i + 1 < len(toks) else ""
            if base in SHELLS and re.fullmatch(r"-\w*c\w*", nxt) and i + 2 < len(toks):
                yield from candidates(toks[i + 2])
            elif base == "eval":
                yield from candidates(" ".join(toks[i + 1:]))
            elif re.sub(r"\d+(\.\d+)*$", "", base) in INTERP and nxt in ("-c", "-e", "-p", "--eval") and i + 2 < len(toks):
                yield from re.split(r"[\s'\",;:()\[\]{}]+", toks[i + 2])
            if excluded(t):
                continue
            yield t
            yield from re.split(r"[<>=,]", t)

def glob_hits(g):
    # Expande {a,b} y compara contra nombres canónicos: *.env, *.{env,pem}, {.env,.env.local}.
    pats, out = [g], []
    while pats:
        p = pats.pop()
        m = re.search(r"\{([^{}]*)\}", p)
        if m:
            pats += [p[:m.start()] + alt + p[m.end():] for alt in m.group(1).split(",")]
        else:
            out.append(p)
    return any(is_secret(p) or any(fnmatch.fnmatch(c, p.lstrip("*/") or p) or fnmatch.fnmatch(c, p)
                                   for c in CANON) for p in out)

try:
    h = json.load(sys.stdin)
    tool, inp = h.get("tool_name"), h.get("tool_input") or {}
    if tool == "Bash":
        hits = [t for t in candidates(str(inp.get("command") or "")) if is_secret(t)]
    elif tool == "Grep":
        hits = [v for v in (inp.get("path"),) if isinstance(v, str) and is_secret(v)]
        g = inp.get("glob")
        if isinstance(g, str) and not g.startswith("!") and glob_hits(g):
            hits.append(g)
    elif tool == "Read":
        hits = [v for v in (inp.get("file_path"),) if isinstance(v, str) and is_secret(v)]
    else:
        hits = []
except Exception:
    sys.exit(0)
if hits:
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "ask",
        "permissionDecisionReason": f"guard-secrets: accede a posible secreto ({', '.join(dict.fromkeys(hits[:3]))}). Requiere OK humano.",
    }}))
sys.exit(0)
